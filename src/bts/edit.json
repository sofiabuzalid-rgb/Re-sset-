  "subtitles": [
    {"v": 0, "a": 0.12, "b": 2.05, "text": "¿Has visto lo que hay atrás de una tienda?"},
    {"v": 0, "a": 2.15, "b": 3.62, "text": "¿Te lo has cuestionado alguna vez?"},
    {"v": 0, "a": 3.62, "b": 5.52, "text": "Es muy divertido entrar atrás de una tienda."},
    {"v": 1, "a": 5.85, "b": 7.90, "text": "Lo primero que tiene que haber es *un orden puro.*"},
    {"v": 2, "a": 8.28, "b": 8.92, "text": "Tiene que haber"},
    {"v": 3, "a": 9.27, "b": 11.15, "text": "todo dividido por tallas y por colores,"},
    {"v": 3, "a": 11.15, "b": 13.66, "text": "y son mangas chicas y son mangas largas."},
    {"v": 4, "a": 13.74, "b": 15.76, "text": "Esta es la parte atrás de la tienda de RE:SET."}
  ],
  "lowerThird": {"name": "ILANA BARADON", "role": "Fundadora de RE:SET", "from": 18, "to": 132},
