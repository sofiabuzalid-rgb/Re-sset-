  "subtitles": [
    {
      "a": 0.08,
      "b": 1.85,
      "text": "Les tengo una idea *buenísima*,"
    },
    {
      "a": 2.02,
      "b": 4.75,
      "text": "por si no saben *qué regalar* esta Navidad."
    },
    {
      "a": 4.84,
      "b": 7.38,
      "text": "Por favor, quiero que vean estas pijamas de RE:SET"
    },
    {
      "a": 7.59,
      "b": 10.12,
      "text": "y lo mejor de todo es que lo puedes combinar con *toda tu familia*."
    },
    {
      "a": 10.21,
      "b": 12.7,
      "text": "Tu hijo, tu hermano se pone a lo mejor *la verde*,"
    },
    {
      "a": 12.85,
      "b": 14.2,
      "text": "*la blanca* se la puede poner"
    },
    {
      "a": 14.47,
      "b": 16.95,
      "text": "tu esposo, y todos van a estar *matching*"
    },
    {
      "a": 17.12,
      "b": 17.96,
      "text": "y *súper cómodos* esta Navidad."
    },
    {
      "a": 18.01,
      "b": 20.7,
      "text": "Así que en serio, si todavía no saben *qué regalar* esta Navidad,"
    },
    {
      "a": 20.85,
      "b": 22.3,
      "text": "dense una vuelta por *RE:SET*,"
    },
    {
      "a": 22.32,
      "b": 23.42,
      "text": "porque yo ya tengo las mías."
    }
  ],
