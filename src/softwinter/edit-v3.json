  "subtitles": [
    {
      "src": "8483",
      "a": 0.1,
      "b": 2.0,
      "text": "Si eres como yo, que te encanta estar en pijama,"
    },
    {
      "src": "8483",
      "a": 2.0,
      "b": 3.95,
      "text": "pero te es súper difícil encontrar"
    },
    {
      "src": "8483",
      "a": 4.05,
      "b": 5.55,
      "text": "un modelo que sea cómodo y bonito,"
    },
    {
      "src": "8483",
      "a": 5.55,
      "b": 6.5,
      "text": "tienes que conocer RE:SET"
    },
    {
      "src": "8483",
      "a": 6.5,
      "b": 8.98,
      "text": "y su nuevo modelo Soft Winter."
    },
    {
      "src": "8488",
      "a": 1.15,
      "b": 3.7,
      "text": "Y bueno, de este lado, aquí están todos los modelos."
    },
    {
      "src": "8488",
      "a": 3.7,
      "b": 5.35,
      "text": "Por favor, quiero que los vean."
    },
    {
      "src": "8488",
      "a": 5.35,
      "b": 8.35,
      "text": "Y de verdad, no están dimensionando la calidad"
    },
    {
      "src": "8488",
      "a": 8.35,
      "b": 10.32,
      "text": "de esta nueva colección."
    },
    {
      "src": "8488",
      "a": 11.4,
      "b": 13.36,
      "text": "¡Por favor, hay de niño!"
    },
    {
      "src": "8488",
      "a": 13.84,
      "b": 15.15,
      "text": "Pero bueno, no se preocupen,"
    },
    {
      "src": "8488",
      "a": 15.15,
      "b": 16.8,
      "text": "que yo me la voy a probar por ustedes."
    }
  ]
