{
  "name": "reset-christmas-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Christmas promotional Reel for RE:SET pajamas & loungewear, built with React + Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render ChristmasReel out/reset-christmas-reel.mp4",
    "still": "remotion still ChristmasReel out/poster.png --frame=60",
    "audio": "python3 scripts/generate-audio.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
